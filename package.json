{
  "name": "ec-site-demo-e2e",
  "version": "1.0.0",
  "description": "EC Site Demo E2E Tests - iPhoneカテゴリページE2Eテスト自動化 (EC-271)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:iphone": "playwright test tests/iphone-category.spec.ts",
    "test:api": "playwright test tests/api-validation.spec.ts",
    "test:performance": "playwright test tests/performance.spec.ts",
    "report": "playwright show-report",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
